{
  "name": "dsh-duet",
  "version": "0.1.4",
  "description": "duet（二重奏）：只用语音就能操作 DSH，边听边说、随时插话的全双工语音助手。",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "full-duplex",
    "voice"
  ],
  "license": "Apache-2.0",
  "author": {
    "name": "YuMS"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/YuMS/dsh-duet.git"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "test": "node scripts/test.mjs",
    "check": "node scripts/check-package.mjs",
    "test:browser": "node tests/browser/settings.mjs && node tests/browser/tutorial.mjs && node tests/browser/feedback.mjs && node tests/browser/connection-hint.mjs && node tests/browser/resilience.mjs && node tests/browser/page-binding.mjs",
    "test:host": "node tests/host/isolated-host.mjs",
    "prepack": "npm run check"
  },
  "type": "module",
  "main": "./src/host/plugin.mjs",
  "exports": {
    ".": {
      "default": "./src/host/plugin.mjs"
    },
    "./client": {
      "default": "./src/client/entry.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "LICENSE",
    "NOTICE",
    "HEROICONS-LICENSE.txt",
    "src/",
    "config/",
    "assets/tutorial-audio/"
  ],
  "dependencies": {
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "playwright": "1.58.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./config/duet.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  }
}
